# Token bot dari @BotFather
TELEGRAM_TOKEN=your_telegram_bot_token_here

# JSON credentials Google Service Account (isi semua dalam 1 baris atau gunakan format Railway)
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"bot-dagangan@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Path database SQLite (opsional, default: dagangan.db)
DB_PATH=dagangan.db
